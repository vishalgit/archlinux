#!/usr/bin/env bash
# Install / update OpenIDEA to the latest GitHub release WITHOUT FUSE:
# the AppImage is extracted once per version and run via AppRun.
set -euo pipefail

REPO="l0ng-ai/openidea"
APP_DIR="$HOME/Applications/openidea"     # versions live in $APP_DIR/<tag>/
CURRENT="$APP_DIR/current"                # symlink -> active version
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP="$HOME/.local/share/applications/openidea.desktop"
KEEP=2   # how many extracted versions to keep (for rollback)

for cmd in curl jq; do
  command -v "$cmd" >/dev/null || { echo "missing: $cmd (sudo pacman -S $cmd)"; exit 1; }
done

mkdir -p "$APP_DIR" "$ICON_DIR" "$(dirname "$DESKTOP")"

# --- 1. find latest release + its AppImage asset -------------------------
auth=()
token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
[[ -n "$token" ]] && auth=(-H "Authorization: Bearer $token")

json=$(curl -fsSL "${auth[@]}" "https://api.github.com/repos/$REPO/releases/latest")
tag=$(jq -r '.tag_name' <<<"$json")
url=$(jq -r '.assets[] | select(.name | test("amd64\\.AppImage$")) | .browser_download_url' <<<"$json" | head -n1)
name=$(basename "$url")

[[ -n "$url" && "$url" != "null" ]] || { echo "No AppImage asset found in $tag"; exit 1; }

# --- 2. download + extract (no FUSE needed) -------------------------------
if [[ -x "$APP_DIR/$tag/AppRun" ]]; then
  echo "OpenIDEA $tag already installed."
else
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  echo "Downloading $name ($tag)..."
  curl -fL --progress-bar -o "$tmp/$name" "$url"
  chmod +x "$tmp/$name"

  echo "Extracting..."
  ( cd "$tmp" && "./$name" --appimage-extract >/dev/null )
  rm -rf "$APP_DIR/$tag"
  mv "$tmp/squashfs-root" "$APP_DIR/$tag"
  echo "Installed OpenIDEA $tag"
fi

ln -sfn "$tag" "$CURRENT"

# --- 3. icon --------------------------------------------------------------
icon=$(find "$CURRENT/" -name '*.png' -printf '%s %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
[[ -n "$icon" ]] && cp "$icon" "$ICON_DIR/openidea.png"

# --- 4. desktop entry -----------------------------------------------------
cat >"$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=OpenIDEA
Comment=IntelliJ-style IDE rebuilt in Rust
Exec=$CURRENT/AppRun %F
Icon=openidea
Terminal=false
Categories=Development;IDE;
StartupWMClass=OpenIDEA
EOF
# If you get a blank window (WebKitGTK in containers / NVIDIA), use instead:
# Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 $CURRENT/AppRun %F

command -v update-desktop-database >/dev/null && update-desktop-database "$(dirname "$DESKTOP")" || true
command -v gtk-update-icon-cache  >/dev/null && gtk-update-icon-cache -q "$HOME/.local/share/icons/hicolor" 2>/dev/null || true

# --- 5. prune old versions (never the active one) -------------------------
ls -1dt "$APP_DIR"/v*/ 2>/dev/null | sed 's:/$::' | grep -vx "$APP_DIR/$tag" \
  | tail -n +"$KEEP" | xargs -r rm -rf
